# Configurações do Portal ZMN Sports

# Chave para API-Football (API-Sports / RapidAPI)
# Obtenha em: https://www.api-football.com/ ou https://rapidapi.com/api-sports/api/api-football
FOOTBALL_API_KEY=

# Host da API-Football (opcional, padrão: v3.football.api-sports.io)
FOOTBALL_API_HOST=v3.football.api-sports.io

# Chave para API de Notícias (opcional - GNews v4)
# Obtenha em: https://gnews.io/
# Se não informada, o portal utiliza feeds RSS esportivos reais oficiais do futebol brasileiro
NEWS_API_KEY=

# Porta do servidor (padrão 3000)
PORT=3000
